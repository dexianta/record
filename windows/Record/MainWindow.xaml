<Window x:Class="Record.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Record"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Record"
        Width="330"
        Height="344"
        MinWidth="330"
        MaxWidth="330"
        MinHeight="344"
        MaxHeight="344"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}">
    <Grid Margin="13">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="9" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="54" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <DockPanel Margin="1,0,1,4">
                <TextBlock Text="Audio" FontSize="11" FontWeight="SemiBold" />
                <TextBlock x:Name="AudioSignalText"
                           Text="Idle"
                           FontSize="10"
                           Foreground="#77000000"
                           HorizontalAlignment="Right" />
            </DockPanel>
            <local:WaveformControl x:Name="AudioWaveform" Height="42" BarBrush="#34A853" />
        </StackPanel>

        <StackPanel Grid.Row="2">
            <DockPanel Margin="1,0,1,4">
                <TextBlock Text="Microphone" FontSize="11" FontWeight="SemiBold" />
                <TextBlock x:Name="MicrophoneSignalText"
                           Text="Idle"
                           FontSize="10"
                           Foreground="#77000000"
                           HorizontalAlignment="Right" />
            </DockPanel>
            <local:WaveformControl x:Name="MicrophoneWaveform" Height="42" BarBrush="#4285F4" />
        </StackPanel>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="7" />
                <ColumnDefinition Width="31" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="SourceComboBox"
                      Grid.Column="0"
                      DisplayMemberPath="DisplayName"
                      ToolTip="Choose all system audio or one running app. Browser tabs cannot be separated." />
            <Button x:Name="RefreshButton"
                    Grid.Column="2"
                    Content="↻"
                    FontSize="16"
                    Padding="0"
                    ToolTip="Refresh running apps"
                    automation:AutomationProperties.Name="Refresh audio sources"
                    Click="RefreshButton_Click" />
        </Grid>

        <TextBlock x:Name="ElapsedText"
                   Grid.Row="6"
                   Text="00:00"
                   FontFamily="Consolas"
                   FontSize="13"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   Visibility="Hidden" />

        <Grid Grid.Row="8">
            <Button x:Name="RecordButton"
                    Width="48"
                    Height="48"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalAlignment="Center"
                    ToolTip="Start recording"
                    automation:AutomationProperties.Name="Record"
                    Click="RecordButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </ControlTemplate>
                </Button.Template>
                <Ellipse Width="30" Height="30" Fill="#FF3B30" />
            </Button>

            <StackPanel x:Name="ActiveControls"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                <Button x:Name="PauseButton"
                        Width="82"
                        Margin="0,0,8,0"
                        Content="Pause"
                        Click="PauseButton_Click" />
                <Button x:Name="StopButton"
                        Width="82"
                        Content="Stop"
                        Foreground="#C5221F"
                        Click="StopButton_Click" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText"
                       Grid.Column="0"
                       Text="Ready"
                       FontSize="10"
                       Foreground="#80000000"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"
                       ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
            <Button x:Name="FolderButton"
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Padding="8,4"
                    Content="Folder"
                    ToolTip="Open recordings folder"
                    Click="FolderButton_Click" />
        </Grid>
    </Grid>
</Window>
